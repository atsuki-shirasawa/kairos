{
  "name": "kairos-docs",
  "private": true,
  "type": "module",
  "description": "The Kairos documentation site, built with Starlight from the repository's Markdown",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "dev": "bun scripts/sync.ts && bun --bun astro dev",
    "build": "bun scripts/sync.ts && bun --bun astro build",
    "preview": "bun --bun astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "astro": "^7.4.0",
    "astro-mermaid": "^2.1.0",
    "github-slugger": "^2.0.0",
    "mermaid": "^11",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
